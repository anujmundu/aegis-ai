# ==============================================================================
# AegisAI: Production Docker Environment Configuration (.env.docker)
# ==============================================================================

# Core Application Settings
ENVIRONMENT=production
SERVICE_NAME=aegis-ai
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2

# Relational Database (PostgreSQL 16)
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis_secure_password
POSTGRES_DB=aegisai
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://aegis:aegis_secure_password@postgres:5432/aegisai
DATABASE_SYNC_URL=postgresql://aegis:aegis_secure_password@postgres:5432/aegisai

# In-Memory Cache & Working Memory (Redis 7)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# MLOps Tracking Server (MLflow)
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=aegisai-production-benchmark

# Vector Knowledge Engine (RAG)
VECTOR_STORE_TYPE=faiss
VECTOR_INDEX_PATH=/app/data/vector_index
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# Worker Streaming Target
AEGIS_API_URL=http://aegis-api:8000
