# Environment & Microservice
ENVIRONMENT=development
SERVICE_NAME=aegis-ai
DEBUG=false

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2

# Relational & Cache Stores
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aegis_ai_db
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/aegis_ai_db
REDIS_URL=redis://localhost:6379/0

# Vector Knowledge Base
VECTOR_STORE_TYPE=faiss
VECTOR_INDEX_PATH=data/vector_index
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# LLM Providers (Default: Local Ollama)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# MLOps & Experiment Tracking
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=aegisai-anomaly-benchmark

# Quality Gates & Detection Thresholds
ZSCORE_THRESHOLD=3.5
EWMA_ALPHA=0.2
ISOLATION_FOREST_CONTAMINATION=0.035
MIN_MODEL_PRECISION=0.90
MAX_MODEL_FPR=0.025
MAX_P99_LATENCY_MS=15.0
MIN_GROUNDING_SCORE=0.95
MAX_AGENT_STEPS=8
